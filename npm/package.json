{
  "name": "otelview",
  "version": "0.2.0",
  "description": "otelview \u2014 open-source, self-hosted OpenTelemetry viewer in a single binary (traces, metrics, logs)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsirysndr/otelview.git"
  },
  "keywords": [
